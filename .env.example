# 이 파일을 .env로 복사해서 값을 채운다. .env는 GitHub에 올리지 않는다.

# Render PostgreSQL 주소
#  - 내 컴퓨터에서: External(외부) 주소 + DB_SSL=true
#  - Render 백엔드에서: Internal(내부) 주소 + DB_SSL=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME
DB_SSL=true

# 로그인 토큰 서명용 비밀값 (아무도 모르는 긴 문자열)
JWT_SECRET=change-me-to-a-long-random-string

# 백엔드를 부를 수 있는 프론트엔드 주소 (쉼표로 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

PORT=4000

# 시드: 처음 관리자 계정 (npm run db:seed 때만 사용)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# 시드: 가상 학부모·직원 계정 공통 비밀번호 (비우면 가상 계정은 만들지 않음)
SEED_DEMO_PASSWORD=

# (선택) Dify 규정 챗봇
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=
